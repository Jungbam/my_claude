{
  "mode": "plan",
  "file": "PLAN.md",
  "min_words": 200,
  "rubric": [
    {"id": "problem-goal", "weight": 2, "any": ["(problem|goal|objective|background|목표|문제|배경)"]},
    {"id": "success-metric", "weight": 2, "any": ["(success metric|metric|KPI|지표)", "(reduce|decrease|감소|줄).{0,60}(ticket|complaint|티켓|불만|문의)"]},
    {"id": "non-goals", "weight": 2, "any": ["non-?goals?", "out of scope", "not in scope", "비목표", "범위 밖|범위에서 제외|제외 범위"]},
    {"id": "requirements-per-category-channel", "weight": 3, "any": ["per[- ]?(category|channel)", "(category|카테고리).{0,80}(channel|채널)", "(channel|채널).{0,80}(category|카테고리)"]},
    {"id": "acceptance-criteria", "weight": 3, "any": ["acceptance criteria", "given .{0,80}when .{0,80}then", "수용 기준|인수 기준|완료 조건"]},
    {"id": "unsubscribe-legal", "weight": 3, "any": ["unsubscribe", "구독 ?취소|수신 ?거부", "CAN-?SPAM|GDPR"]},
    {"id": "mandatory-reminder-carveout", "weight": 2, "any": ["(reminder|security|transactional|보안|필수).{0,100}(cannot|can.t|must not|always|mandatory|required|비활성화.{0,10}(불가|못)|항상|필수)", "(cannot|can.t|always|mandatory|항상|필수).{0,100}(reminder|security|transactional|보안)"]},
    {"id": "quiet-hours-timezone", "weight": 2, "any": ["time ?zone|timezone|시간대|IANA", "quiet hours|방해 ?금지|조용한 ?시간"]},
    {"id": "data-model-migration", "weight": 3, "any": ["migration", "마이그레이션", "schema|스키마", "(table|테이블|column|컬럼).{0,60}(preference|설정)"]},
    {"id": "existing-code-reference", "weight": 2, "any": ["notify\\.ts", "src/notify", "flags\\.ts", "mailer\\.ts"]},
    {"id": "feature-flag-rollout", "weight": 2, "any": ["feature[- ]?flag", "flags\\.ts", "rollout|roll out|단계적|점진", "canary|dark launch"]},
    {"id": "default-backward-compat", "weight": 2, "any": ["default.{0,80}(on|enabled|opt|existing users|all)", "backward|기존 사용자|기본값"]},
    {"id": "testing", "weight": 2, "any": ["unit test", "integration test", "e2e|end-to-end", "테스트"]},
    {"id": "risks", "weight": 2, "any": ["risks?\\b", "리스크|위험"]},
    {"id": "dependencies-order", "weight": 2, "any": ["depends on", "dependency|dependencies", "blocked by", "before .{0,40}can", "의존|선행|순서"]},
    {"id": "estimate-timeline", "weight": 2, "any": ["estimate", "\\b\\d+(\\.\\d+)? ?(d|days?|h|hours?|pt|points?|sp)\\b", "\\bday ?\\d+", "week ?[12]", "일정|견적|[0-9]+일|[0-9]+주"]},
    {"id": "later-channels-sms", "weight": 1, "any": ["SMS", "push"]},
    {"id": "open-questions", "weight": 1, "any": ["open questions?", "assumptions?", "미정|가정|열린 질문|확인 필요"]},
    {"id": "task-count", "weight": 4, "count_regex": "^\\s*(?:[-*]\\s*\\[[ xX]?\\]|[-*]|\\d+[.)]|\\|\\s*T?\\d+)\\s*\\S", "min": 14}
  ]
}
